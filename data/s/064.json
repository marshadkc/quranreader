جو پہلے کافر ہوئے تھے تو انہوں نے اپنے کاموں کی سزا کا مزہ چکھ لیا اور (ابھی) دکھ دینے والا عذاب (اور) ہونا ہے","hi":"क्या तुम्हारे पास उन लोगों की खबर नहीं आई, जिन्होंने इससे पहले कुफ़्र किया। फिर उन्होंने अपने कर्म का दुष्परिणाम चखा? और उनके लिए दुःखदायी यातना है।"},{"n":6,"w":[{"t":"ذَٰلِكَ","p":[["ذَٰلِكَ","s"]],"l":"ذا","r":"","pos":"N","en":"That","ur":"یہ","hi":"ये","f":1058},{"t":"بِأَنَّهُۥ","p":[["بِ","p","bi"],["أَنَّ","s"],["هُۥ","e","pron-3MS"]],"l":"أَنّ","r":"","pos":"P","en":"(is) because","ur":"بوجہ اس کے کہ بیشک وہ","hi":"बवजह उसके कि वो","f":362},{"t":"كَانَت","p":[["كَانَت","s"]],"l":"كانَ","r":"كون","pos":"V","g":"past.3FS","en":"had","ur":"تھے","hi":"थे","f":1358},{"t":"تَّأْتِيهِمْ","p":[["تَّأْتِي","s"],["هِمْ","e","pron-3MP"]],"l":"أَتَى","r":"أتي","pos":"V","g":"pres.3FS","en":"come to them","ur":"آتے ان کے پاس","hi":"आते उनके पास","f":264},{"t":"رُسُلُهُم","p":[["رُسُلُ","s"],["هُم","e","pron-3MP"]],"l":"رَسُول","r":"رسل","pos":"N","g":"MP.NOM","en":"their Messengers","ur":"ان کے رسول","hi":"रसूल उनके","f":332},{"t":"بِٱلْبَيِّنَٰتِ","p":[["بِ","p","bi"],["ٱلْ","p","al"],["بَيِّنَٰتِ","s"]],"l":"بَيِّنَة","r":"بين","pos":"N","g":"FP.GEN","en":"with clear proofs","ur":"ساتھ واضح آیات کے","hi":"साथ वाज़ेह आयात के","f":71},{"t":"فَقَالُوٓا۟","p":[["فَ","p","fa"],["قَالُ","s"],["وٓا۟","e","pron-3MP"]],"l":"قالَ","r":"قول","pos":"V","g":"past.3MP","en":"but they said","ur":"تو وہ کہتے","hi":"तो वो कहते","f":1618},{"t":"أَبَشَرٌ","p":[["أَ","p","a-question"],["بَشَرٌ","s"]],"l":"بَشَر","r":"بشر","pos":"N","g":"M.NOM","en":"Shall human beings","ur":"کیا انسان","hi":"क्या इन्सान","f":37},{"t":"يَهْدُونَنَا","p":[["يَهْدُ","s"],["ونَ","e","pron-3MP"],["نَا","e","pron-1P"]],"l":"هَدَى","r":"هدي","pos":"V","g":"pres.3MP","en":"guide us","ur":"ہدایت دیں گے ہم کو","hi":"रहनुमाई करेंगे हमारी","f":144},{"t":"فَكَفَرُوا۟","p":[["فَ","p","fa"],["كَفَرُ","s"],["وا۟","e","pron-3MP"]],"l":"كَفَرَ","r":"كفر","pos":"V","g":"past.3MP","en":"So they disbelieved",