{"n":107,"ar":"الماعون","en":"Al-Ma'un","meaning":"Small Kindnesses","ayahs":[{"n":1,"w":[{"t":"أَرَءَيْتَ","p":[["أَ","p","a-question"],["رَءَيْ","s"],["تَ","e","pron-2MS"]],"l":"رَأَى","r":"رأي","pos":"V","en":"Have you seen","ur":"کیا دیکھا تم نے","hi":"क्या देखा आपने","f":271},{"t":"ٱلَّذِى","p":[["ٱلَّذِى","s"]],"l":"الَّذِي","r":"","pos":"N","en":"the one who","ur":"اس شخص کو","hi":"उस शख़्स को जो","f":1468},{"t":"يُكَذِّبُ","p":[["يُكَذِّبُ","s"]],"l":"كَذَّبَ","r":"كذب","pos":"V","en":"denies","ur":"جو جھٹلاتا ہے","hi":"झुठलाता है","f":176},{"t":"بِٱلدِّينِ","p":[["بِ","p","bi"],["ٱل","p","al"],["دِّينِ","s"]],"l":"دِين","r":"دين","pos":"N","en":"the Judgment","ur":"جزا و سزا کو","hi":"बदले (के दिन) को","f":92}],"en":"Have you seen the one who denies the Recompense?","ur":"بھلا تم نے اس شخص کو دیکھا جو (روزِ) جزا کو جھٹلاتا ہے؟","hi":"(ऐ नबी!) क्या आपने उसे देखा, जो बदले के दिन को झुठलाता है?"},{"n":2,"w":[{"t":"فَذَٰلِكَ","p":[["فَ","p","fa"],["ذَٰلِكَ","s"]],"l":"ذا","r":"","pos":"N","en":"Then that","ur":"پس یہ وہ","hi":"पस ये","f":1058},{"t":"ٱلَّذِى","p":[["ٱلَّذِى","s"]],"l":"الَّذِي","r":"","pos":"N","en":"(is) the one who","ur":"شخص ہے","hi":"वो है जो","f":1468},{"t":"يَدُعُّ","p":[["يَدُعُّ","s"]],"l":"يَدُعُّ","r":"دعع","pos":"V","en":"repulses","ur":"جو دھکے دیتا ہے","hi":"धक्के देता है","f":2},{"t":"ٱلْيَتِيمَ","p":[["ٱلْ","p","al"],["يَتِيمَ","s"]],"l":"يَتِيم","r":"يتم","pos":"N","en":"the orphan","ur":"یتیم کو","hi":"यतीम को","f":23}],"en":"For that is the one who drives away the orphan","ur":"یہ وہی (بدبخت) ہے، جو یتیم کو دھکے دیتا ہے","hi":"तो यही है, जो अनाथ (यतीम) को धक्के देता है।"},{"n":3,"w":[{"t":"وَلَا","p":[["وَ","p","wa"],["لَا","s"]],"l":"لا","r":"","pos":"P","en":"And (does) not","ur":"اور نہیں","hi":"और नहीं","f":1691},{"t":"يَحُضُّ","p":[["يَحُضُّ","s"]],"l":"يَحُضُّ","r":"حضض","pos":"V","en":"feel the urge","ur":"رغبت دلاتا","hi":"वो रग़बत दिलाता","f":2},{"t":"عَلَىٰ","p":[["عَلَىٰ","s"]],"l":"عَلَى","r":"","pos":"P","en":"to",