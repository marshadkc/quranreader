","s"],["ونَ","e","pron-3MP"]],"l":"يُراءُ","r":"رأي","pos":"V","en":"make show","ur":"دکھاوا کرتے ہیں","hi":"वो रियाकारी करते हैं","f":2}],"en":"Those who make show [of their deeds]","ur":"جو ریا کاری کرتے ہیں","hi":"वे जो दिखावा करते हैं।"},{"n":7,"w":[{"t":"وَيَمْنَعُونَ","p":[["وَ","p","wa"],["يَمْنَعُ","s"],["ونَ","e","pron-3MP"]],"l":"مَنَعَ","r":"منع","pos":"V","en":"And they deny","ur":"اور روکتے ہیں","hi":"और वो रोकते हैं","f":12},{"t":"ٱلْمَاعُونَ","p":[["ٱلْ","p","al"],["مَاعُونَ","s"]],"l":"ماعُون","r":"عون","pos":"N","en":"[the] small kindnesses","ur":"برتنے کی چھوٹی سی چیز کو بھی","hi":"इस्तेमाल की मामूली चीज़ें","f":1}],"en":"And withhold [simple] assistance.","ur":"اور برتنے کی چیزیں عاریتہً نہیں دیتے","hi":"तथा साधारण बरतने की चीज़ भी माँगने से नहीं देते।"}]}