{"n":93,"ar":"الضحى","en":"Ad-Duha","meaning":"The Morning Light","ayahs":[{"n":1,"w":[{"t":"وَٱلضُّحَىٰ","p":[["وَ","p","wa-oath"],["ٱل","p","al"],["ضُّحَىٰ","s"]],"l":"ضُحًى","r":"ضحو","pos":"N","en":"By the morning brightness","ur":"قسم ہے روز روشن کی","hi":"क़सम है चाश्त की","f":6}],"en":"By the morning brightness","ur":"آفتاب کی روشنی کی قسم","hi":"कस़म है धूप चढ़ने के समय की!"},{"n":2,"w":[{"t":"وَٱلَّيْلِ","p":[["وَ","p","wa"],["ٱلَّ","p","al"],["يْلِ","s"]],"l":"لَيْل","r":"ليل","pos":"N","en":"And the night","ur":"اور رات کی","hi":"और रात की","f":84},{"t":"إِذَا","p":[["إِذَا","s"]],"l":"إِذا","r":"","pos":"N","en":"when","ur":"جب","hi":"जब","f":423},{"t":"سَجَىٰ","p":[["سَجَىٰ","s"]],"l":"سَجَى","r":"سجو","pos":"V","en":"it covers with darkness","ur":"وہ ڈھانپ لے","hi":"वो छा जाए","f":1}],"en":"And [by] the night when it covers with darkness,","ur":"اور رات (کی تاریکی) کی جب چھا جائے","hi":"और क़सम है रात की, जब वह छा जाए।"},{"n":3,"w":[{"t":"مَا","p":[["مَا","s"]],"l":"ما","r":"","pos":"P","en":"Not","ur":"نہیں","hi":"नहीं","f":2177},{"t":"وَدَّعَكَ","p":[["وَدَّعَ","s"],["كَ","e","pron-2MS"]],"l":"وَدَّعَ","r":"ودع","pos":"V","en":"has forsaken you","ur":"چھوڑا تجھ کو","hi":"छोड़ा आपको","f":1},{"t":"رَبُّكَ","p":[["رَبُّ","s"],["كَ","e","pron-2MS"]],"l":"رَبّ","r":"ربب","pos":"N","en":"your Lord","ur":"تیرے رب نے","hi":"आपके रब ने","f":975},{"t":"وَمَا","p":[["وَ","p","wa"],["مَا","s"]],"l":"ما","r":"","pos":"P","en":"and not","ur":"اور نہ","hi":"और ना","f":2177},{"t":"قَلَىٰ","p":[["قَلَىٰ","s"]],"l":"قَلَى","r":"قلي","pos":"V","en":"He is displeased","ur":"وہ ناراض ہوا","hi":"वो नाराज़ हुआ","f":1}],"en":"Your Lord has not taken leave of you, [O Muḥammad], nor has He detested [you].","ur":"کہ (اے محمدﷺ) تمہارے پروردگار نے نہ تو تم کو چھوڑا اور نہ( تم سے )ناراض ہوا","hi":"(ऐ नबी!) तेरे पालनहार ने तुझे न तो छोड़ा और न नाराज़ हुआ।"},{"n":4,"w":[{"t":"وَلَلْءَاخِرَةُ","p":[["وَ","p","wa"],["لَ","p","la"],["لْ","p","al"],["ءَاخِرَةُ","s"]],"l":"آخِر","r":"أخر","pos":"N","en":"And surely the Hereafter","ur":"اور البتہ آخرت/ انجام","hi":"और यक़ीनन आख़िरत","f":155},{"t":"خَيْرٌ","p":[["خَيْرٌ","s"]],"l":"خَيْر","r":"خير","pos":"N","en":"(is) better","ur":"بہتر ہے","hi":"बेहतर है","f":178},{"t":"لَّكَ","p":[["لَّ","p","li"],["كَ","s"]],"l":"لَّكَ","r":"","pos":"N","en":"for you","ur":"تیرے لئے","hi":"आपके लिए","f":10},{"t":"مِنَ","p":[["مِنَ","s"]],"l":"مِن","r":"","pos":"P","en":"than","ur":"سے","f":3226},{"t":"ٱلْأُولَىٰ","p":[["ٱلْ","p","al"],["أُولَىٰ","s"]],"l":"أَوَّل","r":"أول","pos":"N","en":"the first","ur":"آغاز سے/ ابتداء سے","hi":"पहली (दुनिया) से","f":82}],"en":"And the Hereafter is better for you than the first [life].","ur":"اور آخرت تمہارے لیے پہلی (حالت یعنی دنیا) سے کہیں بہتر ہے","hi":"और निश्चित रूप से आख़िरत आपके लिए दुनिया से बेहतर है।"},{"n":5,"w":[{"t":"وَلَسَوْفَ","p":[["وَ","p","wa"],["لَ","p","la"],["سَوْفَ","s"]],"l":"سَوْف","r":"","pos":"P","en":"And soon","ur":"اور البتہ عنقریب","hi":"और यक़ीनन अनक़रीब","f":42},{"t":"يُعْطِيكَ","p":[["يُعْطِي","s"],["كَ","e","pron-2MS"]],"l":"أَعْطَى","r":"عطو","pos":"V","en":"will give you","ur":"عطا کرے گا تجھ کو","hi":"अता करेगा आपको","f":8},{"t":"رَبُّكَ","p":[["رَبُّ","s"],["كَ","e","pron-2MS"]],"l":"رَبّ","r":"ربب","pos":"N","en":"your Lord","ur":"تیرا رب","hi":"रब आपका","f":975},{"t":"فَتَرْضَىٰٓ","p":[["فَ","p","fa"],["تَرْضَىٰٓ","s"]],"l":"رَضِيَ","r":"رضو","pos":"V","en":"then you will be satisfied","ur":"تو تو راضی ہوجائے گا/ خوش ہوجائے گا","hi":"तो आप राज़ी हो जाऐंगे","f":38}],"en":"And your Lord is going to give you, and you will be satisfied.","ur":"اور تمہیں پروردگار عنقریب وہ کچھ عطا فرمائے گا کہ تم خوش ہو جاؤ گے","hi":"और निश्चय तेरा पालनहार तुझे प्रदान करेगा, तो तू प्रसन्न हो जाएगा।"},{"n":6,"w":[{"t":"أَلَمْ","p":[["أَ","p","a-question"],["لَمْ","s"]],"l":"لَم","r":"","pos":"P","en":"Did not","ur":"کیا نہیں","hi":"क्या नहीं","f":347},{"t":"يَجِدْكَ","p":[["يَجِدْ","s"],["كَ","e","pron-2MS"]],"l":"وَجَدَ","r":"وجد","pos":"V","en":"He find you","ur":"پایا تجھ کو","hi":"उसने पाया आपको","f":106},{"t":"يَتِيمًا","p":[["يَتِيمًا","s"]],"l":"يَتِيم","r":"يتم","pos":"N","en":"an orphan","ur":"یتیم","hi":"यतीम","f":23},{"t":"فَـَٔاوَىٰ","p":[["فَ","p","fa"],["ـَٔاوَىٰ","s"]],"l":"آوَى","r":"أوي","pos":"V","en":"and give shelter","ur":"پھر اس نے ٹھکانہ فراہم کیا","hi":"फिर उसने ठिकान फ़राहम किया","f":9}],"en":"Did He not find you an orphan and give [you] refuge?","ur":"بھلا اس نے تمہیں یتیم پا کر جگہ نہیں دی؟ (بےشک دی)","hi":"क्या उसने आपको अनाथ पाकर शरण नहीं दी?"},{"n":7,"w":[{"t":"وَوَجَدَكَ","p":[["وَ","p","wa"],["وَجَدَ","s"],["كَ","e","pron-2MS"]],"l":"وَجَدَ","r":"وجد","pos":"V","en":"And He found you","ur":"اور پایا تجھ کو","hi":"और उसने पाया आपको","f":106},{"t":"ضَآلًّا","p":[["ضَآلًّا","s"]],"l":"ضالّ","r":"ضلل","pos":"N","en":"lost","ur":"راہ بھولا","hi":"राह भूला","f":14},{"t":"فَهَدَىٰ","p":[["فَ","p","fa"],["هَدَىٰ","s"]],"l":"هَدَى","r":"هدي","pos":"V","en":"so He guided","ur":"تو اس نے ہدایت بخشی/ رہنمائی کی","hi":"तो उसने रहनुमाई की","f":144}],"en":"And He found you lost and guided [you],","ur":"اور رستے سے ناواقف دیکھا تو رستہ دکھایا","hi":"और आपको मार्ग से अनभिज्ञ पाया, तो सीधा मार्ग दिखाया।"},{"n":8,"w":[{"t":"وَوَجَدَكَ","p":[["وَ","p","wa"],["وَجَدَ","s"],["كَ","e","pron-2MS"]],"l":"وَجَدَ","r":"وجد","pos":"V","en":"And He found you","ur":"اور پایا تجھ کو","hi":"और उसने पाया आपको","f":106},{"t":"عَآئِلًا","p":[["عَآئِلًا","s"]],"l":"عائِل","r":"عيل","pos":"N","en":"in need","ur":"مفلس","hi":"तंग दस्त","f":1},{"t":"فَأَغْنَىٰ","p":[["فَ","p","fa"],["أَغْنَىٰ","s"]],"l":"أَغْنَى","r":"غني","pos":"V","en":"so He made self-sufficient","ur":"تو اس نے غنی کردیا","hi":"तो उसने ग़नी कर दिया","f":15}],"en":"And He found you poor and made [you] self-sufficient.","ur":"اور تنگ دست پایا تو غنی کر دیا","hi":"और उसने आपको निर्धन पाया, तो संपन्न कर दिया।"},{"n":9,"w":[{"t":"فَأَمَّا","p":[["فَ","p","fa"],["أَمَّا","s"]],"l":"أَمّا","r":"","pos":"P","en":"So as for","ur":"تو رہا","hi":"तो रहा","f":55},{"t":"ٱلْيَتِيمَ","p":[["ٱلْ","p","al"],["يَتِيمَ","s"]],"l":"يَتِيم","r":"يتم","pos":"N","en":"the orphan","ur":"یتیم","hi":"यतीम","f":23},{"t":"فَلَا","p":[["فَ","p","fa"],["لَا","s"]],"l":"لا","r":"","pos":"P","en":"then (do) not","ur":"پس نہ","hi":"पस ना","f":1691},{"t":"تَقْهَرْ","p":[["تَقْهَرْ","s"]],"l":"تَقْهَرْ","r":"قهر","pos":"V","en":"oppress","ur":"سختی کر","hi":"आप सख़्ती कीजिए(उस पर)","f":1}],"en":"So as for the orphan, do not oppress [him].","ur":"تو تم بھی یتیم پر ستم نہ کرنا","hi":"अतः आप अनाथ पर कठोरता न दिखाएँ।"},{"n":10,"w":[{"t":"وَأَمَّا","p":[["وَ","p","wa"],["أَمَّا","s"]],"l":"أَمّا","r":"","pos":"P","en":"And as for","ur":"اور رہا","hi":"और रहा","f":55},{"t":"ٱلسَّآئِلَ","p":[["ٱل","p","al"],["سَّآئِلَ","s"]],"l":"سائِل","r":"سأل","pos":"N","en":"one who asks","ur":"سوالی","hi":"सवाली","f":7},{"t":"فَلَا","p":[["فَ","p","fa"],["لَا","s"]],"l":"لا","r":"","pos":"P","en":"then (do) not","ur":"پس نہ","hi":"पस ना","f":1691},{"t":"تَنْهَرْ","p":[["تَنْهَرْ","s"]],"l":"تَنْهَرْ","r":"نهر","pos":"V","en":"repel","ur":"جھڑکو","hi":"आप झिड़कये (उसे)","f":2}],"en":"And as for the petitioner, do not repel [him].","ur":"اور مانگنے والے کو جھڑکی نہ دینا","hi":"और माँगने वाले को न झिड़कें।"},{"n":11,"w":[{"t":"وَأَمَّا","p":[["وَ","p","wa"],["أَمَّا","s"]],"l":"أَمّا","r":"","pos":"P","en":"But as for","ur":"اور رہی","hi":"और लेकिन","f":55},{"t":"بِنِعْمَةِ","p":[["بِ","p","bi"],["نِعْمَةِ","s"]],"l":"نِعْمَة","r":"نعم","pos":"N","en":"(the) Favor","ur":"نعمت","f":50},{"t":"رَبِّكَ","p":[["رَبِّ","s"],["كَ","e","pron-2MS"]],"l":"رَبّ","r":"ربب","pos":"N","en":"(of) your Lord","ur":"اپنے رب کی","hi":"अपने रब की नेअमत को","f":975},{"t":"فَحَدِّثْ","p":[["فَ","p","fa"],["حَدِّثْ","s"]],"l":"تُحَدِّثُ","r":"حدث","pos":"V","en":"narrate","ur":"پس بیان کرو","hi":"पस बयान कीजिए","f":3}],"en":"But as for the favor of your Lord, report [it].","ur":"اور اپنے پروردگار کی نعمتوں کا بیان کرتے رہنا","hi":"और अपने रब के उपकार का वर्णन करते रहें।"}]}